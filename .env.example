# NexaERP Environment Configuration Template
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_PORT=5173

# Security
SECRET_KEY=nexa_erp_dev_super_secret_key_987654321_token_safe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./nexaerp.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Gateway (Groq / Gemini / OpenAI / AWS Bedrock)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Amazon Alexa+ & Developer Challenge 2026 Integrations
ALEXA_SKILL_ID=amzn1.ask.skill.nexaerp-voice-command
AWS_REGION=us-east-1
